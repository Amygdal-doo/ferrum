{
  "name": "ferrum-desktop-css",
  "private": true,
  "description": "Build-time Tailwind CSS tooling only. No JavaScript ships in the app.",
  "scripts": {
    "css": "tailwindcss -i tailwind.css -o assets/tailwind.css --minify",
    "css:watch": "tailwindcss -i tailwind.css -o assets/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "packageManager": "pnpm@10.0.0"
}
